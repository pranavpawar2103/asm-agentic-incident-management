PROJECT_NAME="AMS Agentic Incident Management"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL="INFO"

# Database connection (Supabase PostgreSQL / asyncpg)
# Direct connection:
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# Or Supabase Pooler (Transaction / Session mode):
# DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Optional overrides (defaults: data/tickets/ams_tickets.xlsx and data/registry in the repo)
# TICKETS_FILE="../data/tickets/ams_tickets.xlsx"
# REGISTRY_DIR="../data/registry"

# Model access (off by default; the pipeline then runs rules only)
# LLM_ENABLED=true
# LLM_PROVIDER="anthropic"       # anthropic (Claude API) | bedrock (the client's route, later)
# LLM_MODEL="claude-sonnet-5-5"
# LLM_EFFORT="low"
# LLM_REFUSAL_FALLBACK=true      # Claude API only; set false for models without server-side fallback
# LLM_TIMEOUT_S=60
# LLM_TRANSPORT_RETRIES=2         # network, timeout, 429 and 5xx retries inside the SDK
# LLM_VALIDATION_ATTEMPTS=2       # 2 = one retry when an answer fails validation
# AWS_REGION="ca-central-1"      # bedrock only; must be in ALLOWED_AWS_REGIONS
# DQ_OUTAGE_BREAKER=5             # outages in a row that stop a Data Quality run
# EMBEDDING_MODEL="google/embeddinggemma-300m"  # recorded per row; embeddings are generated outside the app
# EMBEDDING_DIM=256               # must match kb_chunks.embedding vector(256)
# KB_CONTEXT_MODEL="claude-haiku-5-5"  # contextual retrieval blurb per chunk, at ingest time
# KB_CHUNK_SIZE=1200              # characters per chunk before splitting large issue blocks
# KB_CHUNK_OVERLAP=150
# TRIAGE_OUTAGE_BREAKER=5         # outages in a row after which a Triage run uses rules only
# CLOSURE_OUTAGE_BREAKER=5        # outages in a row that stop a Closure Quality run
# KNOWLEDGE_OUTAGE_BREAKER=5      # outages in a row that stop a Knowledge Builder run
# ANTHROPIC_API_KEY="sk-ant-..."  # here (.env is gitignored) or in the environment; never commit it
# Bedrock uses the usual AWS credentials from the environment

# Admin API (/api/v1/admin/settings, /api/v1/admin/documents): change settings, rules, PII terms and prompts at
# runtime; send the key as X-Admin-Key.
# Empty = admin endpoints switched off. These two can only be set here, never through the API.
# ADMIN_API_KEY="<long random string>"
# ALLOWED_AWS_REGIONS=["ca-central-1"]
